<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>BPH Meeting Pivot Generator</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --gold: #FFC000;
  --gold-dk: #c99800;
  --navy: #1a3a6b;
  --navy-lt: #e8f0fc;
  --red: #FF9999;
  --red-dk: #cc0000;
  --gray-bg: #f4f6fb;
  --gray-border: #dde2ec;
  --gray-text: #556;
  --radius: 10px;
  --shadow: 0 1px 5px rgba(0,0,0,0.09);
}

body { font-family: 'Segoe UI', system-ui, sans-serif; background: var(--gray-bg); color: #222; min-height: 100vh; }

/* ── Header ── */
header {
  background: var(--navy);
  padding: 16px 28px;
  display: flex; align-items: center; gap: 14px;
  box-shadow: 0 2px 12px rgba(0,0,0,0.2);
}
.logo {
  width: 40px; height: 40px; border-radius: 9px;
  background: var(--gold); display: flex; align-items: center; justify-content: center;
  font-weight: 800; font-size: 15px; color: var(--navy); flex-shrink: 0;
}
header h1 { font-size: 17px; font-weight: 600; color: #fff; letter-spacing: -0.01em; }
header p { font-size: 11.5px; color: rgba(255,255,255,0.55); margin-top: 2px; }

main { max-width: 960px; margin: 0 auto; padding: 28px 20px 80px; }

/* ── Cards ── */
.card {
  background: #fff; border-radius: var(--radius);
  box-shadow: var(--shadow); margin-bottom: 18px; overflow: hidden;
}
.card-head {
  padding: 13px 20px; border-bottom: 1px solid #eef0f5;
  display: flex; align-items: center; gap: 10px;
}
.card-head h2 { font-size: 13.5px; font-weight: 600; color: var(--navy); }
.step-badge {
  width: 22px; height: 22px; border-radius: 50%;
  background: var(--gold); color: var(--navy);
  font-weight: 800; font-size: 11px;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.card-body { padding: 18px 20px; }

/* ── Drop zone ── */
.drop-zone {
  border: 2px dashed var(--gray-border);
  border-radius: 9px; padding: 48px 20px;
  text-align: center; cursor: pointer;
  transition: all 0.18s; background: #fafbfd;
  position: relative;
}
.drop-zone input[type=file] {
  position: absolute; inset: 0; opacity: 0;
  cursor: pointer; width: 100%; height: 100%;
}
.drop-zone.drag-over { border-color: var(--gold); background: #fffbee; }
.drop-icon { font-size: 36px; margin-bottom: 10px; }
.drop-label { font-size: 15px; font-weight: 600; color: var(--navy); margin-bottom: 5px; }
.drop-sub { font-size: 12px; color: #999; }
.drop-sub b { color: var(--gray-text); }

/* ── File list ── */
.file-list { margin-top: 14px; display: flex; flex-direction: column; gap: 6px; }
.file-item {
  display: flex; align-items: center; gap: 10px;
  background: var(--navy-lt); border: 1px solid #c5d5f5;
  border-radius: 7px; padding: 8px 12px; font-size: 12.5px;
}
.file-item .fi-icon { font-size: 18px; flex-shrink: 0; }
.file-item .fi-name { font-weight: 600; color: var(--navy); flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.file-item .fi-date {
  background: var(--gold); color: var(--navy); font-weight: 700;
  font-size: 11px; padding: 2px 8px; border-radius: 10px; flex-shrink: 0;
}
.file-item .fi-date.no-date {
  background: var(--red); color: #700;
}
.file-item .fi-remove {
  background: none; border: none; cursor: pointer;
  color: #aaa; font-size: 16px; line-height: 1; padding: 0 2px;
  flex-shrink: 0;
}
.file-item .fi-remove:hover { color: var(--red-dk); }
.file-item .fi-count { font-size: 11px; color: var(--gray-text); flex-shrink: 0; }

/* ── Controls ── */
.controls { display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-end; }
.ctrl { display: flex; flex-direction: column; gap: 5px; }
.ctrl label { font-size: 12px; font-weight: 600; color: var(--navy); }
.ctrl input, .ctrl select {
  border: 1.5px solid var(--gray-border); border-radius: 7px;
  padding: 7px 11px; font-size: 13px; font-family: inherit; color: #333;
  background: white; transition: border-color 0.15s; min-width: 140px;
}
.ctrl input:focus, .ctrl select:focus { outline: none; border-color: var(--gold); }

/* ── Buttons ── */
.btn {
  padding: 9px 20px; border: none; border-radius: 7px;
  font-size: 13.5px; font-weight: 600; cursor: pointer;
  transition: all 0.15s; display: inline-flex; align-items: center; gap: 7px;
  white-space: nowrap;
}
.btn-primary { background: var(--navy); color: #fff; }
.btn-primary:hover { background: #26508c; transform: translateY(-1px); }
.btn-gold { background: var(--gold); color: var(--navy); }
.btn-gold:hover { background: var(--gold-dk); transform: translateY(-1px); }
.btn:active { transform: translateY(0) !important; }
.btn:disabled { opacity: 0.35; cursor: default; transform: none !important; }
.btn-sm { padding: 6px 13px; font-size: 12px; }

/* ── Status ── */
.status {
  padding: 9px 13px; border-radius: 7px; font-size: 12.5px;
  margin-top: 10px; display: none;
}
.status.show { display: block; }
.status.info    { background: #e8f4ff; color: #1a5a9a; border: 1px solid #b5d5f5; }
.status.success { background: #e8f8ed; color: #1a6a3a; border: 1px solid #a8ddb5; }
.status.error   { background: #fff0f0; color: #991a1a; border: 1px solid #f5b3b3; }
.status.warn    { background: #fffbe6; color: #7a6000; border: 1px solid #ffe58f; }

/* ── Preview table ── */
.preview-scroll { overflow-x: auto; margin-top: 4px; }
table.pivot {
  border-collapse: collapse; font-size: 12.5px; min-width: 100%;
}
table.pivot th, table.pivot td {
  border: 1px solid var(--gray-border); padding: 6px 10px;
  text-align: center; white-space: nowrap;
}
table.pivot th {
  background: var(--gold); color: var(--navy); font-weight: 700; font-size: 11.5px;
}
table.pivot th.name-col, table.pivot td.name-col {
  text-align: left; min-width: 170px; max-width: 220px;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
table.pivot tr:nth-child(even) td:not(.hrs):not(.short) { background: #f2f2f2; }
table.pivot tr:nth-child(odd) td:not(.hrs):not(.short)  { background: #ffffff; }
table.pivot td.zero  { color: #bbb; }
table.pivot td.short { background: var(--red) !important; font-weight: 600; }
table.pivot td.hrs   { background: var(--gold) !important; font-weight: 700; color: var(--navy); }
table.pivot td.wktot { font-weight: 600; }
table.pivot .legend-row td { background: var(--red) !important; font-size: 11px; font-weight: 700; color: #700; text-align: left; border: none; }

/* ── Summary chips ── */
.chip-row { display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 12px; }
.chip {
  background: var(--navy-lt); color: var(--navy); border: 1px solid #c5d5f5;
  border-radius: 20px; padding: 3px 10px; font-size: 11.5px; font-weight: 500;
}
.divider { height: 1px; background: #eef0f5; margin: 14px 0; }
</style>
</head>
<body>

<header>
  <div class="logo">BPH</div>
  <div>
    <h1>Meeting Pivot Generator</h1>
    <p>Import Excel attendance files → pivot table + Excel download · Date pulled from filename</p>
  </div>
</header>

<main>

  <!-- Step 1: Import files -->
  <div class="card">
    <div class="card-head">
      <div class="step-badge">1</div>
      <h2>Import Attendance Files</h2>
    </div>
    <div class="card-body">
      <div class="drop-zone" id="dropZone">
        <input type="file" id="fileInput" accept=".xlsx,.xls,.csv" multiple>
        <div class="drop-icon">📂</div>
        <div class="drop-label">Drop Excel files here, or click to browse</div>
        <div class="drop-sub">
          Select one or more <b>.xlsx</b> files — one per meeting day.<br>
          The <b>date is read from the filename</b> (e.g. <b>Attendance_8-25-2026.xlsx</b> or <b>2026-08-25_meeting.xlsx</b>).
        </div>
      </div>
      <div class="file-list" id="fileList"></div>
      <div id="importStatus" class="status"></div>
    </div>
  </div>

  <!-- Step 2: Settings -->
  <div class="card">
    <div class="card-head">
      <div class="step-badge">2</div>
      <h2>Settings</h2>
    </div>
    <div class="card-body">
      <div class="controls">
        <div class="ctrl">
          <label>Week Label</label>
          <input type="text" id="weekLabel" placeholder="Auto-generated from dates" style="min-width:220px;">
        </div>
        <div class="ctrl">
          <label>Short Attendance (≤ min)</label>
          <input type="number" id="threshold" value="5" min="1" max="120" style="min-width:70px; max-width:90px;">
        </div>
        <div class="ctrl">
          <label>Exclude (comma-separated)</label>
          <input type="text" id="excludeNames" value="Blueprint Health Training" style="min-width:260px;">
        </div>
      </div>
      <div class="divider"></div>
      <div style="display:flex; gap:10px; flex-wrap:wrap; align-items:center;">
        <button class="btn btn-primary" onclick="generate()">⚡ Generate Pivot</button>
        <button class="btn btn-gold" id="dlBtn" onclick="downloadExcel()" disabled>⬇ Download Excel</button>
        <button class="btn btn-sm" style="background:#f0f0f0; color:#555;" onclick="clearAll()">✕ Clear All</button>
      </div>
    </div>
  </div>

  <!-- Step 3: Preview -->
  <div class="card" id="previewCard" style="display:none;">
    <div class="card-head">
      <div class="step-badge">3</div>
      <h2 id="previewTitle">Preview</h2>
    </div>
    <div class="card-body">
      <div class="chip-row" id="nameChips"></div>
      <div class="preview-scroll">
        <div id="tableWrap"></div>
      </div>
      <div style="display:flex; align-items:center; gap:8px; margin-top:10px; font-size:12px; color:#777;">
        <span style="display:inline-block; width:14px; height:14px; background:var(--red); border-radius:3px; border:1px solid #ccc;"></span>
        Present 5 min or less
        <span style="display:inline-block; width:14px; height:14px; background:var(--gold); border-radius:3px; border:1px solid #ccc; margin-left:10px;"></span>
        Total hours (0.5 hr / session)
      </div>
      <div id="genStatus" class="status"></div>
    </div>
  </div>

</main>

<script>
// ── State ─────────────────────────────────────────────────────────────────────
const loadedFiles = []; // { file, date, name, records: [{name, duration}] }
let pivotData = null;

// ── Date extraction from filename ─────────────────────────────────────────────
function extractDateFromFilename(filename) {
  // Try common patterns:
  // 8-25-2026, 08-25-2026, 8_25_2026, 08_25_2026
  // 2026-08-25, 2026_08_25
  // Aug25, Aug-25-2026, August_25_2026
  // "Team Meeting_2026-06-22 08_52_5" (AttendList style)

  const months = {jan:1,feb:2,mar:3,apr:4,may:5,jun:6,
                  jul:7,aug:8,sep:9,oct:10,nov:11,dec:12,
                  january:1,february:2,march:3,april:4,june:6,
                  july:7,august:8,september:9,october:10,november:11,december:12};

  let m, day, month, year;

  // YYYY-MM-DD or YYYY_MM_DD
  m = filename.match(/(\d{4})[-_](\d{1,2})[-_](\d{1,2})/);
  if (m) { year=+m[1]; month=+m[2]; day=+m[3]; }

  // M-D-YYYY or M_D_YYYY (month first)
  if (!year) {
    m = filename.match(/(\d{1,2})[-_](\d{1,2})[-_](\d{4})/);
    if (m) { month=+m[1]; day=+m[2]; year=+m[3]; }
  }

  // Month name: Aug25_2026 / August-25-2026
  if (!year) {
    m = filename.toLowerCase().match(/([a-z]+)[-_\s]?(\d{1,2})[-_,\s]+(\d{4})/);
    if (m && months[m[1]]) { month=months[m[1]]; day=+m[2]; year=+m[3]; }
  }

  // Month name, year first: 2026-Aug-25
  if (!year) {
    m = filename.toLowerCase().match(/(\d{4})[-_\s]([a-z]+)[-_\s](\d{1,2})/);
    if (m && months[m[2]]) { year=+m[1]; month=months[m[2]]; day=+m[3]; }
  }

  if (!year || !month || !day) return null;
  // Validate
  if (month < 1 || month > 12 || day < 1 || day > 31) return null;
  return `${month}/${day}/${year}`;
}

// ── Duration parser ───────────────────────────────────────────────────────────
function parseDuration(val) {
  if (val === null || val === undefined || val === '') return 0;
  const s = String(val).trim().toLowerCase();
  // Pure number (minutes)
  if (/^\d+(\.\d+)?$/.test(s)) return Math.round(parseFloat(s));
  // "X min" / "X m"
  let h = 0, mins = 0, sec = 0;
  const hr  = s.match(/(\d+)\s*h/);  if (hr)  h    = +hr[1];
  const mn  = s.match(/(\d+)\s*m/);  if (mn)  mins = +mn[1];
  const sc  = s.match(/(\d+)\s*s/);  if (sc)  sec  = +sc[1];
  if (h === 0 && mins === 0 && sec === 0) {
    const n = s.match(/(\d+)/);
    if (n) return +n[1];
  }
  return h * 60 + mins + Math.round(sec / 60);
}

// ── Excel parser ──────────────────────────────────────────────────────────────
function parseExcelFile(wb, filename) {
  const records = [];
  const excluded = getExcluded();

  for (const sheetName of wb.SheetNames) {
    const ws = wb.Sheets[sheetName];
    const rows = XLSX.utils.sheet_to_json(ws, { header: 1, defval: '' });
    if (!rows.length) continue;

    // Try to detect format by scanning first ~15 rows
    let fmt = detectFormat(rows);

    if (fmt === 'google') {
      // Google Meet: header row has Date, First name, Last name, Email, Duration...
      // Find header row
      let hdrIdx = -1;
      for (let i = 0; i < Math.min(rows.length, 10); i++) {
        const r = rows[i].map(c => String(c).toLowerCase());
        if (r.some(c => c.includes('duration') || c.includes('time in'))) { hdrIdx = i; break; }
      }
      if (hdrIdx < 0) hdrIdx = 0;
      const hdr = rows[hdrIdx].map(c => String(c).toLowerCase().trim());
      const iFirst  = hdr.findIndex(h => h.includes('first'));
      const iLast   = hdr.findIndex(h => h.includes('last'));
      const iName   = hdr.findIndex(h => h === 'name' || h === 'name:');
      const iDur    = hdr.findIndex(h => h.includes('duration') || h.includes('time in'));

      for (let i = hdrIdx + 1; i < rows.length; i++) {
        const row = rows[i];
        if (!row.some(c => c !== '')) continue;
        let name = '';
        if (iFirst >= 0) {
          const first = String(row[iFirst] || '').trim();
          const last  = iLast >= 0 ? String(row[iLast] || '').trim() : '';
          name = (first + ' ' + last).trim();
        } else if (iName >= 0) {
          name = String(row[iName] || '').trim();
        } else {
          name = String(row[0] || '').trim();
        }
        if (!name || excluded.some(ex => name.toLowerCase().includes(ex))) continue;
        const dur = iDur >= 0 ? parseDuration(row[iDur]) : 0;
        records.push({ name, duration: dur });
      }
    } else if (fmt === 'attendlist') {
      // AttendList: rows like Name: | Time in call: | ...
      // Find participant section
      let inPart = false;
      for (let i = 0; i < rows.length; i++) {
        const row = rows[i];
        const r0  = String(row[0] || '').trim();
        const r1  = String(row[1] || '').trim();
        if (/participants/i.test(r0)) { inPart = true; continue; }
        if (inPart && /name:/i.test(r0)) continue; // header
        if (inPart && /report generated/i.test(r0)) break;
        if (inPart && /^-+$/.test(r0)) break;
        if (inPart && r0) {
          const name = r0;
          if (excluded.some(ex => name.toLowerCase().includes(ex))) continue;
          const dur = parseDuration(r1);
          if (name && name !== 'NaN') records.push({ name, duration: dur });
        }
      }
    } else {
      // Fallback: scan for name + duration pattern
      for (let i = 1; i < rows.length; i++) {
        const row = rows[i];
        const name = String(row[0] || '').trim();
        if (!name || excluded.some(ex => name.toLowerCase().includes(ex))) continue;
        if (name.toLowerCase().includes('report') || name.startsWith('--')) continue;
        const dur = parseDuration(row[1]);
        if (name) records.push({ name, duration: dur });
      }
    }
  }

  // Deduplicate by name (keep max duration)
  const map = {};
  for (const r of records) {
    if (!map[r.name] || r.duration > map[r.name]) map[r.name] = r.duration;
  }
  return Object.entries(map).map(([name, duration]) => ({ name, duration }));
}

function detectFormat(rows) {
  for (let i = 0; i < Math.min(rows.length, 15); i++) {
    const flat = rows[i].map(c => String(c).toLowerCase()).join(' ');
    if (flat.includes('first name') || flat.includes('first joined') || flat.includes('time exited') || flat.includes('time joined')) return 'google';
    if (flat.includes('participants') || flat.includes('meeting code') || flat.includes('recorded by')) return 'attendlist';
    if (flat.includes('duration') && flat.includes('name')) return 'google';
  }
  return 'attendlist';
}

function getExcluded() {
  return document.getElementById('excludeNames').value
    .split(',').map(s => s.trim().toLowerCase()).filter(Boolean);
}

// ── File handling ─────────────────────────────────────────────────────────────
function handleFiles(files) {
  for (const file of files) {
    if (loadedFiles.find(f => f.file.name === file.name)) continue; // skip dupe
    const date = extractDateFromFilename(file.name);
    loadedFiles.push({ file, date, name: file.name, records: null });
    const reader = new FileReader();
    reader.onload = e => {
      const data = new Uint8Array(e.target.result);
      const wb   = XLSX.read(data, { type: 'array' });
      const entry = loadedFiles.find(f => f.file.name === file.name);
      if (entry) {
        entry.records = parseExcelFile(wb, file.name);
        entry.parsed  = true;
      }
      renderFileList();
    };
    reader.readAsArrayBuffer(file);
  }
  renderFileList();
}

function renderFileList() {
  const el = document.getElementById('fileList');
  if (!loadedFiles.length) { el.innerHTML = ''; return; }

  el.innerHTML = loadedFiles.map((f, i) => {
    const hasDate = !!f.date;
    const count   = f.records ? f.records.length : '…';
    return `<div class="file-item">
      <span class="fi-icon">📄</span>
      <span class="fi-name" title="${f.name}">${f.name}</span>
      <span class="fi-count">${count} attendees</span>
      <span class="fi-date ${hasDate ? '' : 'no-date'}">${hasDate ? f.date : '⚠ No date found'}</span>
      <button class="fi-remove" onclick="removeFile(${i})" title="Remove">✕</button>
    </div>`;
  }).join('');

  const noDate = loadedFiles.filter(f => !f.date);
  if (noDate.length) {
    showStatus('importStatus', `⚠ ${noDate.length} file(s) have no recognizable date in the filename. Rename them to include the date (e.g. Attendance_8-25-2026.xlsx) and re-import.`, 'warn');
  } else {
    showStatus('importStatus', `${loadedFiles.length} file(s) loaded · ${loadedFiles.filter(f=>f.records).length} parsed`, 'success');
  }
}

function removeFile(i) {
  loadedFiles.splice(i, 1);
  renderFileList();
  document.getElementById('previewCard').style.display = 'none';
  document.getElementById('dlBtn').disabled = true;
}

function clearAll() {
  loadedFiles.length = 0;
  pivotData = null;
  renderFileList();
  document.getElementById('fileList').innerHTML = '';
  document.getElementById('previewCard').style.display = 'none';
  document.getElementById('dlBtn').disabled = true;
  document.getElementById('weekLabel').value = '';
  document.getElementById('importStatus').className = 'status';
}

// ── Generate pivot ─────────────────────────────────────────────────────────────
function generate() {
  const valid = loadedFiles.filter(f => f.date && f.records);
  if (!valid.length) {
    showStatus('importStatus', 'No valid files with dates. Import Excel files first.', 'error'); return;
  }

  const threshold = parseInt(document.getElementById('threshold').value) || 5;

  // Sort by date
  valid.sort((a, b) => new Date(a.date) - new Date(b.date));

  const dates = valid.map(f => f.date);

  // Collect all unique names across all files
  const nameSet = new Set();
  for (const f of valid) for (const r of f.records) nameSet.add(r.name);
  const names = [...nameSet].sort();

  // Build attendance & duration maps
  const attendance = {}, duration = {};
  for (const name of names) {
    attendance[name] = {}; duration[name] = {};
    for (const f of valid) {
      const rec = f.records.find(r => r.name === name);
      if (rec && rec.duration > 0) {
        attendance[name][f.date] = 1;
        duration[name][f.date]   = rec.duration;
      } else {
        attendance[name][f.date] = 0;
        duration[name][f.date]   = null;
      }
    }
  }

  // Auto label
  const autoLabel = dates.length >= 2
    ? `${dates[0]} – ${dates[dates.length-1]} Meeting`
    : `${dates[0]} Meeting`;
  const label = document.getElementById('weekLabel').value.trim() || autoLabel;
  if (!document.getElementById('weekLabel').value.trim())
    document.getElementById('weekLabel').value = autoLabel;

  pivotData = { dates, names, attendance, duration, threshold, label };
  renderPreview();
  document.getElementById('dlBtn').disabled = false;
}

function renderPreview() {
  const { dates, names, attendance, duration, threshold, label } = pivotData;

  document.getElementById('previewTitle').textContent = `Preview — ${label}`;
  document.getElementById('previewCard').style.display = '';

  // Name chips
  document.getElementById('nameChips').innerHTML =
    names.map(n => `<span class="chip">${n}</span>`).join('');

  // Table
  let html = `<table class="pivot"><thead><tr>
    <th class="name-col">${label}</th>`;
  for (const d of dates) html += `<th>${d}</th>`;
  html += `<th>Week Total</th><th>Total Hours</th></tr></thead><tbody>`;

  for (const name of names) {
    html += `<tr><td class="name-col" title="${name}">${name}</td>`;
    let tot = 0;
    for (const d of dates) {
      const val  = attendance[name][d];
      const mins = duration[name][d];
      const short = val === 1 && mins !== null && mins <= threshold;
      html += `<td class="${val === 0 ? 'zero' : short ? 'short' : ''}">${val}</td>`;
      tot += val;
    }
    const hrs = (tot * 0.5).toFixed(1);
    html += `<td class="wktot">${tot}</td><td class="hrs">${hrs} hr</td></tr>`;
  }
  html += `</tbody></table>`;
  document.getElementById('tableWrap').innerHTML = html;

  showStatus('genStatus',
    `${names.length} participants · ${dates.length} sessions · Legend: light red = ${threshold} min or less`,
    'success');
}

// ── Download Excel ─────────────────────────────────────────────────────────────
function downloadExcel() {
  if (!pivotData) return;
  const { dates, names, attendance, duration, threshold, label } = pivotData;

  const rows = [[label, ...dates, 'Week Total', 'Total Hours']];

  for (const name of names) {
    const row = [name];
    let tot = 0;
    for (const d of dates) { row.push(attendance[name][d]); tot += attendance[name][d]; }
    row.push(tot);
    row.push(parseFloat((tot * 0.5).toFixed(1)));
    rows.push(row);
  }
  rows.push([]);
  rows.push([`Present ${threshold} min or less = highlighted (light red)`]);
  rows.push(['Google Meet Attendance Export']);

  const ws = XLSX.utils.aoa_to_sheet(rows);
  ws['!cols'] = [{ wch: 28 }, ...dates.map(() => ({ wch: 13 })), { wch: 13 }, { wch: 13 }];

  // Format hours column
  for (let r = 1; r <= names.length; r++) {
    const addr = XLSX.utils.encode_cell({ r, c: dates.length + 2 });
    if (ws[addr]) ws[addr].z = '0.0"hr"';
  }

  const wb2 = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb2, ws, label.replace(/[:\\\/\?\*\[\]]/g,'').substring(0,31));
  XLSX.writeFile(wb2, `BPH_Pivot_${label.replace(/[^a-zA-Z0-9]/g,'_')}.xlsx`);
  showStatus('genStatus', 'Excel file downloaded!', 'success');
}

// ── UI helpers ────────────────────────────────────────────────────────────────
function showStatus(id, msg, type) {
  const el = document.getElementById(id);
  el.textContent = msg;
  el.className = `status ${type} show`;
}

// Drop zone events
const dz = document.getElementById('dropZone');
const fi = document.getElementById('fileInput');
dz.addEventListener('dragover', e => { e.preventDefault(); dz.classList.add('drag-over'); });
dz.addEventListener('dragleave', () => dz.classList.remove('drag-over'));
dz.addEventListener('drop', e => {
  e.preventDefault(); dz.classList.remove('drag-over');
  handleFiles([...e.dataTransfer.files]);
});
fi.addEventListener('change', () => { handleFiles([...fi.files]); fi.value = ''; });
</script>
